# ============================================
# CloudCart Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================

# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cloudcart?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_jwt_secret_here_use_a_long_random_string_64_chars_min
JWT_EXPIRE=7d

# AWS S3
AWS_REGION=us-east-1
AWS_S3_BUCKET=cloudcart-product-images-your-unique-suffix

# AWS Credentials (only for local development — on EC2, use IAM Role instead)
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
